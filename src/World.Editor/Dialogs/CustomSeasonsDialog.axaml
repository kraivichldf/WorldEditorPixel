<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:Kingdom.World.Editor.Dialogs"
        x:Class="Kingdom.World.Editor.Dialogs.CustomSeasonsDialog"
        Title="Manage Seasons"
        Width="1080" Height="780" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{StaticResource Win98ActiveTitleBrush}" Padding="10,7">
      <StackPanel Spacing="2">
        <TextBlock Text="SEASON CATALOG" Foreground="White" FontWeight="Bold" />
        <TextBlock Text="Each definition is an independent Season Occurrence type. Built-in identity is protected; display, rules, and generated state are editable."
                   Foreground="White" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12" ColumnDefinitions="310,12,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="INDEPENDENT SEASONS" Classes="section-title" />
        <ListBox x:Name="DefinitionsList" Grid.Row="1" MinHeight="320"
                 AutomationProperties.Name="Season definitions">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="dialogs:SeasonDefinitionEditorItem">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="7" Margin="2">
                <Border Width="14" Height="14" Margin="0,2,0,0"
                        Background="{Binding SwatchBrush}"
                        BorderBrush="{StaticResource Win98DarkShadowBrush}" BorderThickness="1" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding IdText}" Classes="measurement" FontSize="10"
                             Foreground="{StaticResource EditorMutedTextBrush}" />
                  <TextBlock Text="{Binding SourceAndUsageText}" FontSize="10"
                             Foreground="{StaticResource EditorMutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding GenerationStateText}" FontSize="10"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="List order is display-only. Every matching generated season can coexist on a tile."
                   FontSize="10" Foreground="{StaticResource EditorMutedTextBrush}" TextWrapping="Wrap" />
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="7">
          <Button Content="Add custom" Classes="quiet" Click="Add_OnClick" />
          <Button Grid.Column="1" Content="Duplicate" Classes="quiet" Click="Duplicate_OnClick" />
        </Grid>
        <Border Grid.Row="4" Classes="win98-group">
          <StackPanel Spacing="6">
            <TextBlock Text="DELETE CUSTOM" Classes="section-title" />
            <ComboBox x:Name="ReplacementInput"
                      AutomationProperties.Name="Replacement for used deleted season" />
            <Button x:Name="DeleteButton" Content="Delete selected" Classes="quiet"
                    Click="Delete_OnClick" />
            <TextBlock Text="A custom season with occurrences needs a replacement. Occurrences keep their coordinates and lock state."
                       FontSize="10" Foreground="{StaticResource EditorMutedTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DetailsPanel" Spacing="10">
          <Border Classes="win98-group">
            <StackPanel Spacing="7">
              <TextBlock Text="IDENTITY AND DISPLAY" Classes="section-title" />
              <TextBlock x:Name="IdentityHelpText" FontSize="11"
                         Foreground="{StaticResource EditorMutedTextBrush}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="Name" />
                  <TextBox x:Name="NameInput" MaxLength="64" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Stable ID" />
                  <TextBox x:Name="IdInput" MaxLength="64" PlaceholderText="lowercase-portable-id" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="4">
                  <TextBlock Text="Fallback behavior" />
                  <ComboBox x:Name="FallbackInput" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                      ColumnDefinitions="*,64" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Map color" />
                    <TextBox x:Name="ColorInput" MaxLength="7" PlaceholderText="#RRGGBB" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Preview" />
                    <Border x:Name="ColorPreview" Height="28"
                            BorderBrush="{StaticResource Win98DarkShadowBrush}" BorderThickness="1" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
                  <TextBlock Text="Tint strength (%)" />
                  <NumericUpDown x:Name="TintInput" Minimum="0" Maximum="100"
                                 Increment="1" FormatString="N0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Spacing="4">
                  <TextBlock Text="Effect intensity (%)" />
                  <NumericUpDown x:Name="EffectInput" Minimum="0" Maximum="100"
                                 Increment="1" FormatString="N0" />
                </StackPanel>
              </Grid>
              <CheckBox x:Name="GenerationEnabledInput" Content="Enabled for generation" />
              <TextBlock Text="New custom seasons start manual-only. Every enabled definition evaluates independently, so all matching seasons can coexist on a tile."
                         FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="win98-group">
            <StackPanel Spacing="7">
              <TextBlock Text="RULE RANGES" Classes="section-title" />
              <TextBlock Text="Enter min..max; leave blank for no limit. Values are inclusive."
                         FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" />
              <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Spacing="3"><TextBlock Text="Latitude (degrees)" /><TextBox x:Name="LatitudeInput" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="Elevation (m)" /><TextBox x:Name="ElevationInput" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Temperature (°C)" /><TextBox x:Name="TemperatureInput" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Moisture (0..1)" /><TextBox x:Name="MoistureInput" /></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Warm-season temperature (°C)" /><TextBox x:Name="WarmTemperatureInput" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Cold-season temperature (°C)" /><TextBox x:Name="ColdTemperatureInput" /></StackPanel>
                <StackPanel Grid.Row="3" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Annual temperature range (°C)" /><TextBox x:Name="AnnualRangeInput" /></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Seasonality (0..1)" /><TextBox x:Name="SeasonalityInput" /></StackPanel>
                <StackPanel Grid.Row="4" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Sea distance (km)" /><TextBox x:Name="SeaDistanceInput" /></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,7,0,0" Spacing="3"><TextBlock Text="Lake distance (km)" /><TextBox x:Name="LakeDistanceInput" /></StackPanel>
                <StackPanel Grid.Row="5" Margin="0,7,0,0" Spacing="3"><TextBlock Text="River distance (km)" /><TextBox x:Name="RiverDistanceInput" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="win98-group">
            <StackPanel Spacing="7">
              <TextBlock Text="TERRAIN FILTERS" Classes="section-title" />
              <TextBlock Text="Comma-separated enum names or custom stable IDs. Includes form a whitelist; excludes always win."
                         FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="Built-in terrain includes" /><TextBox x:Name="TerrainIncludesInput" />
              <TextBlock Text="Built-in terrain excludes" /><TextBox x:Name="TerrainExcludesInput" />
              <TextBlock Text="Custom terrain includes" /><TextBox x:Name="CustomIncludesInput" />
              <TextBlock Text="Custom terrain excludes" /><TextBox x:Name="CustomExcludesInput" />
            </StackPanel>
          </Border>

          <Border x:Name="ValidationPanel" Background="#FFFFE1"
                  BorderBrush="{StaticResource Win98ErrorBrush}" BorderThickness="1" Padding="7"
                  IsVisible="False">
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{StaticResource Win98ShadowBrush}"
            BorderThickness="0,1,0,0" Padding="10,8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Applying definition or generated-selection changes is atomic and clears Undo/Redo only when authority changes."
                   FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Cancel" Classes="quiet" Click="Cancel_OnClick" />
        <Button Grid.Column="2" Content="Apply seasons" Classes="primary" Click="Apply_OnClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
